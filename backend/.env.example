# Gmail OAuth configuration
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/email/oauth/callback

# Comma-separated email addresses permitted to submit tasks
GMAIL_ALLOWED_SENDERS=sender@example.com

# Automatic Gmail inbox polling interval in seconds
GMAIL_POLL_INTERVAL_SECONDS=60
